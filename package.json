{
	"name": "tiranicida-ca",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@10.9.0",
	"engines": {
		"node": "22.22.2",
		"npm": ">=10.9.0 <11"
	},
	"workspaces": ["apps/*"],
	"scripts": {
		"build": "turbo run build",
		"ci": "npm run guard && npm run typecheck && npm run build",
		"clean": "turbo run clean",
		"deploy": "turbo run deploy --filter=@tiranicida-ca/site",
		"dev": "turbo run dev --filter=@tiranicida-ca/site",
		"guard": "npm run guard:versions && npm run guard:root && npm run guard:readme",
		"guard:readme": "node scripts/verify-readme.mjs",
		"guard:root": "versioning cleanup scan",
		"guard:versions": "versioning validate",
		"prepare": "husky",
		"release:check": "npm run ci",
		"release:patch": "node scripts/prepare-patch-release.mjs",
		"release:pr": "node scripts/create-release-pr.mjs",
		"release:tag": "node scripts/create-release-tag.mjs",
		"secrets:check": "versioning check-secrets",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@edcalderon/versioning": "1.5.13",
		"husky": "9.1.7",
		"turbo": "2.10.11"
	}
}
